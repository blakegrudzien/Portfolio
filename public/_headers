# Vite fingerprints these filenames with a content hash, so a given URL can
# never change contents. Without this they are served max-age=0,
# must-revalidate, which makes every repeat visitor pay a conditional
# request for each of ~15 files (including 284KB of fonts) just to be told
# nothing changed.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# These filenames are stable, so they cannot be cached forever: replacing
# the headshot or the resume has to actually reach people. A day is long
# enough to help and short enough to correct.
/headshot.webp
  Cache-Control: public, max-age=86400
/chess-scholar.webp
  Cache-Control: public, max-age=86400
/og.jpg
  Cache-Control: public, max-age=86400
/Blake_Grudzien_Resume.pdf
  Cache-Control: public, max-age=3600
